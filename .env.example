# ---------------------------------------------------------------------------
# LiveKit Cloud project
# Get these from LiveKit Cloud > Project Settings > Keys, or run:
# lk app env -w -d .env.local
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=


# LiveKit Inference: STT, TTS, turn detection, and noise cancellation
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=en-IN
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley
LIVEKIT_NOISE_CANCELLATION_MODEL=quailVfS

# ---------------------------------------------------------------------------
# Voice behavior
# ---------------------------------------------------------------------------
BEGIN_MESSAGE=Hello! Welcome to customer support. How can I help you today?
VOICE_SUPPORT_BRAND=Mr Brand
VOICE_THINKING_MESSAGE=One moment while I check that for you.
VOICE_THINKING_DELAY_MS=500
VOICE_HISTORY_MAX_CHARS=16000
VOICE_RESPONSE_TARGET_MS=15000
VOICE_RESPONSE_HARD_TIMEOUT_MS=45000
VOICE_RESPONSE_RESERVE_MS=750
VOICE_LOG_TRANSCRIPTS=true

# Show the recognized words in local logs. Keep false in production if the
# transcript can contain personal information.
VOICE_LOG_TRANSCRIPTS=true

# ---------------------------------------------------------------------------
# Existing RAG configuration. Copy the SAME values from the working backend.
# No Cosmos re-ingestion is needed when database/container are unchanged.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_PLANNER_MODEL=claude-haiku-4-5-20251001
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_ID=zendesk-rag
COSMOS_CONTAINER_ID=knowledge
COSMOS_VECTOR_INDEX_TYPE=quantizedFlat
RAG_VECTOR_DIMENSIONS=1024

RAG_CANDIDATE_COUNT=24
RAG_FINAL_CHUNK_COUNT=10
RAG_MAX_CHUNKS_PER_SECTION=4
RAG_MAX_CHUNKS_PER_PRODUCT=3
RAG_MAX_STRUCTURED_RESULTS=100
RAG_MAX_VECTOR_DISTANCE=0.55
RAG_STRICT_DISTANCE_CUTOFF=false
RAG_QUERY_PLANNING_ENABLED=true
RAG_RECOVERY_ENABLED=true
RAG_MAX_RECOVERY_QUERIES=3
RAG_COMPACT_CONTEXT=true
RAG_CITATION_REPAIR_ENABLED=true
RAG_INCLUDE_SOURCES=false
RAG_DEBUG=false
RAG_EMBEDDING_CACHE_TTL_MS=3600000
RAG_EMBEDDING_CACHE_MAX_ENTRIES=500
BOT_ANSWER_EFFORT=medium
BOT_PLANNER_EFFORT=low
BOT_STRUCTURED_ANSWERS=true
BOT_WARM_CATALOG=true
